{
  "name": "dentiva-pro",
  "productName": "Dentiva Pro",
  "version": "1.0.0",
  "description": "Dentiva Pro — premium offline-first Dental Clinic Management System for Windows",
  "author": {
    "name": "Shohan Khan",
    "email": "helloiamshohan@gmail.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --external:better-sqlite3 --external:electron --external:yazl --external:yauzl --outfile=out/main/index.js --sourcemap && node -e \"require('fs').copyFileSync('src/main/db/schema.sql','out/main/schema.sql')\"",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --external:electron --outfile=out/preload/index.js --sourcemap",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "icon": "node scripts/build-icon.mjs",
    "pack:win": "electron-builder --win",
    "checksum": "node scripts/checksum.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "yauzl": "^3.2.0",
    "yazl": "^3.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "eslint": "^9.14.0",
    "png-to-ico": "^2.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "zod": "^3.23.8"
  }
}
